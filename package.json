{
  "name": "fullstack-js-starter",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:full": "docker compose up -d && pnpm run dev",
    "dev": "pnpm --filter backend --filter frontend --parallel run dev",
    "build": "pnpm --filter frontend build",
    "start": "pnpm --filter backend start",
    "test": "pnpm --filter backend test",
    "check": "oxlint . && oxfmt --check .",
    "check:fix": "oxlint --fix . && oxfmt --write ."
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.9.1"
}
